{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "curtis-panel",
  "version": "0.1.0-alpha",
  "identifier": "com.newell.openpanel",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "curtis-panel",
        "visible": false,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "width": 900,
        "height": 800
      },
      {
        "label": "peek",
        "title": "curtis-panel",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "width": 6,
        "height": 120
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
