{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openpanel",
  "version": "0.1.0-alpha",
  "identifier": "com.newell.openpanel",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "title": "openpanel",
        "width": 480,
        "height": 640,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
